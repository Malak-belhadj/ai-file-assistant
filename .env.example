# Copy this file to ".env" (same folder) and fill in your values.
# NEVER upload .env to GitHub: it contains your secret bot token.

# Token given by @BotFather in Telegram (looks like 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to control your PC, separated by commas.
# Leave empty the first time: the bot will tell you your ID.
TELEGRAM_ALLOWED_USERS=
